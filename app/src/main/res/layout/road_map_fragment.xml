<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.snatik.matches.ui.road.RoadMapView
        android:id="@+id/road_map"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ImageView
        android:id="@+id/back_button"
        android:layout_width="@dimen/screen_back_button"
        android:layout_height="@dimen/screen_back_button"
        android:layout_gravity="start|top"
        android:layout_marginStart="@dimen/screen_back_margin"
        android:layout_marginTop="@dimen/screen_back_margin"
        android:contentDescription="@string/cd_back"
        android:padding="4dp"
        tools:src="@drawable/button_back" />

    <!-- Stars earned and rounds done on this road. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="@dimen/screen_back_button"
        android:layout_gravity="end|top"
        android:layout_marginTop="@dimen/screen_back_margin"
        android:layout_marginEnd="@dimen/road_header_margin_end"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/stars_icon"
            android:layout_width="@dimen/road_header_star"
            android:layout_height="@dimen/road_header_star"
            android:importantForAccessibility="no"
            tools:src="@drawable/level_complete_star" />

        <TextView
            android:id="@+id/stars_text"
            style="@style/RoadHeaderText"
            android:layout_marginStart="@dimen/road_header_gap"
            tools:text="27" />

        <TextView
            android:id="@+id/rounds_text"
            style="@style/RoadHeaderText"
            android:layout_marginStart="@dimen/road_header_group_gap"
            tools:text="12 / 40" />
    </LinearLayout>

</FrameLayout>
