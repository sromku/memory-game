                    android:shadowRadius="4"
                    android:textColor="@color/white"
                    android:textSize="@dimen/difficulty_best_text_size"
                    tools:text="@string/best_time_format" />
            </LinearLayout>
        </FrameLayout>

    </LinearLayout>

