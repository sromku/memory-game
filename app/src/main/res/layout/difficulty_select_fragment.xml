<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingStart="@dimen/difficulty_padding"
    android:paddingTop="@dimen/difficulty_margin"
    android:paddingEnd="@dimen/difficulty_padding"
    android:paddingBottom="@dimen/difficulty_margin"
    tools:ignore="NestedWeights">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/difficulty_margin"
        android:layout_marginEnd="@dimen/difficulty_margin"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Each cell gets half the column. The button keeps its aspect ratio and shrinks to whatever
             height the cell can give it (set in code); the best-time footer follows the button width. -->
        <FrameLayout
            android:id="@+id/cell_difficulty_1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            tools:ignore="UselessParent">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                tools:ignore="UseCompoundDrawables">

                <ImageView
                    android:id="@+id/select_difficulty_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    tools:ignore="ContentDescription"
                    tools:src="@drawable/button_difficulty_1_star_0" />

                <TextView
                    android:id="@+id/time_difficulty_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/difficulty_best_gap"
                    android:fontFamily="@font/grobold"
                    android:gravity="center"
                    android:shadowColor="@color/text_shadow"
                    android:shadowDx="3"
                    android:shadowDy="3"
                    android:shadowRadius="4"
                    android:textColor="@color/white"
                    android:textSize="@dimen/difficulty_best_text_size"
                    tools:text="@string/best_time_format" />
            </LinearLayout>
        </FrameLayout>

        <!-- Each cell gets half the column. The button keeps its aspect ratio and shrinks to whatever
             height the cell can give it (set in code); the best-time footer follows the button width. -->
