<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/album_section_gap"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/name"
            style="@style/RoadHeaderText"
            android:textSize="@dimen/road_header_text_size"
            tools:text="@string/theme_animals" />

        <TextView
            android:id="@+id/count"
            style="@style/RoadHeaderText"
            android:layout_marginStart="@dimen/road_header_group_gap"
            android:textSize="@dimen/road_header_text_size"
            tools:text="3 / 28" />
    </LinearLayout>

    <androidx.gridlayout.widget.GridLayout
        android:id="@+id/grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/road_header_gap" />
</LinearLayout>
