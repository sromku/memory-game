<resources>
    <style name="Theme.MemoryGame" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/sky</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="RoadHeaderText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/grobold</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/road_header_text_size</item>
        <item name="android:shadowColor">@color/text_shadow</item>
        <item name="android:shadowDx">3</item>
        <item name="android:shadowDy">3</item>
        <item name="android:shadowRadius">4</item>
    </style>
</resources>
