<?xml version="1.0" encoding="utf-8"?>
<!-- Compile-time references to the button art. Indexing into these arrays replaces the old
     Resources.getIdentifier() string lookups, which are slow and break under resource shrinking. -->
<resources>
    <!-- Theme cards, indexed by average star count 0..3. -->
    <array name="theme_card_animals">
        <item>@drawable/animals_theme_star_0</item>
        <item>@drawable/animals_theme_star_1</item>
        <item>@drawable/animals_theme_star_2</item>
        <item>@drawable/animals_theme_star_3</item>
    </array>
    <array name="theme_card_monsters">
        <item>@drawable/monsters_theme_star_0</item>
        <item>@drawable/monsters_theme_star_1</item>
        <item>@drawable/monsters_theme_star_2</item>
        <item>@drawable/monsters_theme_star_3</item>
    </array>
    <array name="theme_card_ocean">
        <item>@drawable/ocean_theme_star_0</item>
        <item>@drawable/ocean_theme_star_1</item>
        <item>@drawable/ocean_theme_star_2</item>
        <item>@drawable/ocean_theme_star_3</item>
    </array>
    <array name="theme_card_emoji">
        <item>@drawable/emoji_theme_star_0</item>
        <item>@drawable/emoji_theme_star_1</item>
        <item>@drawable/emoji_theme_star_2</item>
        <item>@drawable/emoji_theme_star_3</item>
    </array>

    <!-- Difficulty buttons: index = (difficulty - 1) * 4 + stars. -->
    <array name="difficulty_buttons">
        <item>@drawable/button_difficulty_1_star_0</item>
        <item>@drawable/button_difficulty_1_star_1</item>
        <item>@drawable/button_difficulty_1_star_2</item>
        <item>@drawable/button_difficulty_1_star_3</item>
        <item>@drawable/button_difficulty_2_star_0</item>
        <item>@drawable/button_difficulty_2_star_1</item>
        <item>@drawable/button_difficulty_2_star_2</item>
        <item>@drawable/button_difficulty_2_star_3</item>
        <item>@drawable/button_difficulty_3_star_0</item>
        <item>@drawable/button_difficulty_3_star_1</item>
        <item>@drawable/button_difficulty_3_star_2</item>
        <item>@drawable/button_difficulty_3_star_3</item>
        <item>@drawable/button_difficulty_4_star_0</item>
        <item>@drawable/button_difficulty_4_star_1</item>
        <item>@drawable/button_difficulty_4_star_2</item>
        <item>@drawable/button_difficulty_4_star_3</item>
        <item>@drawable/button_difficulty_5_star_0</item>
        <item>@drawable/button_difficulty_5_star_1</item>
        <item>@drawable/button_difficulty_5_star_2</item>
        <item>@drawable/button_difficulty_5_star_3</item>
        <item>@drawable/button_difficulty_6_star_0</item>
        <item>@drawable/button_difficulty_6_star_1</item>
        <item>@drawable/button_difficulty_6_star_2</item>
        <item>@drawable/button_difficulty_6_star_3</item>
    </array>
</resources>
